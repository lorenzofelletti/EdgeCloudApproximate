FROM rust:1-slim-bookworm AS rust-builder

RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    pkg-config

FROM rust-builder AS builder-producer

WORKDIR /build
COPY kafka-producer-rs .

RUN cargo build --release

FROM rust-builder AS builder-edge

WORKDIR /build
COPY kafka-edge-bin .
RUN cargo build --release


FROM docker.io/bitnamilegacy/kafka:3.4

USER root

WORKDIR /

RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    pkg-config \
    vim \
    git \
    curl

# Build producer
COPY --from=builder-producer /build/target/release/kafka-producer-rs /kafka-producer-rs

# Copy config file
COPY ./kafka-rs-configs/producer_config.toml /producer_config.toml

# Build edge
COPY --from=builder-edge /build/target/release/kafka-edge-rs /kafka-edge-rs
# Copy config file
COPY ./kafka-rs-configs/kafka_edge_config-kafka.toml /kafka_edge_config.toml

# Copy startup script
COPY ./docker-startup-scripts/startup-kafka.sh /startup.sh
RUN chmod +x /startup.sh
